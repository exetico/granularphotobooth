{
  "app": {
    "host": "127.0.0.1",
    "port": 8080,
    "debug": false,
    "kiosk_mode": false,
    "log_file": "logs/photobooth.log",
    "min_free_disk_mb": 500
  },
  "admin": {
    "pin": "",
    "corner_taps": 5
  },
  "ui": {
    "countdown_blur": false,
    "mirror_preview": true,
    "trigger_keys": ["Space", "Enter", "NumpadEnter", "PageDown", "PageUp"],
    "tap_anywhere_to_start": true,
    "lock_ui": true,
    "texts": {
      "idle": "Tap anywhere to start",
      "smile": "Smile!"
    }
  },
  "camera": {
    "backend": "webcam",
    "fallback_to_webcam": false,
    "capture_timeout_seconds": 30,
    "capture_retries": 2,
    "preview_fps": 15,
    "backends": {
      "webcam": {
        "device_index": 0,
        "resolution": [1280, 720],
        "preview_resolution": [640, 360]
      },
      "dslr_gphoto2": {
        "model_hint": "Canon EOS 650D",
        "liveview": true,
        "kill_ptpcamera_on_macos": true,
        "delete_after_download": false,
        "iso": "",
        "aperture": "",
        "shutter_speed": ""
      },
      "ip_cam": {
        "stream_url": "",
        "snapshot_url": ""
      },
      "dummy": {
        "resolution": [1800, 1200]
      }
    }
  },
  "input": {
    "triggers": ["websocket_button"],
    "keyboard": {
      "trigger_key": "space"
    },
    "debounce_ms": 800
  },
  "sequence": {
    "shots": 4,
    "countdown_seconds": 3,
    "first_countdown_seconds": 5,
    "show_shot_seconds": 1.5,
    "delay_between_shots_seconds": 0,
    "preview_duration_seconds": 12,
    "retake_mode": "restart",
    "max_session_seconds": 300
  },
  "compositor": {
    "enabled": true,
    "template_image": "",
    "overlay_image": "",
    "template_map": "assets/layouts/4shot_strip.json",
    "background_color": "#ffffff",
    "output_format": "JPEG",
    "output_quality": 92
  },
  "storage": {
    "targets": ["local_disk"],
    "local_disk": {
      "enabled": true,
      "raw_dir": "output/raw/",
      "composite_dir": "output/composites/",
      "filename_format": "{session}_{kind}.jpg"
    },
    "s3_minio": {
      "enabled": false,
      "endpoint_url": "https://s3.amazonaws.com",
      "bucket": "photobooth-photos",
      "access_key": "",
      "secret_key": "",
      "prefix": "events/2026/"
    },
    "ftp_nas": {
      "enabled": false,
      "host": "192.168.1.100",
      "port": 21,
      "username": "",
      "password": "",
      "remote_dir": "/photos/"
    }
  }
}
